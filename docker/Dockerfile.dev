# ============================================
# ft_transcendence — Development Container (Optimized)
# ============================================
# Alpine-based Node.js 22 with everything for full-stack:
#   NestJS + React + Prisma + WebSockets + File uploads
#
# 🚀 OPTIMIZATIONS:
#   • Single RUN layer for apk (fewer layers = faster pull)
#   • npm cache preserved in named volume
#   • Global tools pinned to avoid unnecessary re-installs
#   • Healthcheck uses lightweight node eval (no curl overhead)
# ============================================

FROM node:22-alpine

# ── System Dependencies (single layer) ───────────────
# Combined into ONE RUN to minimize image layers and build time.
# Each dependency serves a specific feature requirement:
#
#   bash, curl, jq, make    → developer tooling / Makefile
#   git                     → npm git deps if any
#   python3, g++, make      → native module compilation (bcrypt, sharp, etc.)
#   openssl, libc6-compat   → Prisma engine binary compatibility
#   postgresql16-client     → psql CLI for DB debugging
#   redis                   → redis-cli for cache debugging
#   imagemagick             → image processing (file upload thumbnails)
#   file                    → MIME type detection (file upload validation)
#   shadow                  → usermod/groupadd (non-root setup)
RUN apk add --no-cache \
    bash curl git jq make psmisc procps \
    python3 g++ \
    openssl libc6-compat \
    postgresql16-client \
    redis \
    imagemagick \
    file \
    shadow \
    && rm -rf /var/cache/apk/*

# ── Working Directory ────────────────────────────────
WORKDIR /app

# ── NPM Configuration (speed + silence) ─────────────
ENV NPM_CONFIG_LOGLEVEL=warn \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_PREFER_OFFLINE=true

# ── Global Tools (pinned versions = reproducible) ────
# Installed once, cached in image layer.
RUN npm install -g --prefer-offline \
    typescript@~5.7 \
    @nestjs/cli@~11 \
    prisma@~6 \
    concurrently@~9 \
    2>/dev/null && npm cache clean --force

# ── Upload directory (with correct permissions) ──────
RUN mkdir -p /app/uploads && chmod 777 /app/uploads

# ── Healthcheck (lightweight — no curl) ──────────────
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "process.exit(0)" || exit 1

# ── Default: Keep Container Alive ────────────────────
CMD ["tail", "-f", "/dev/null"]
