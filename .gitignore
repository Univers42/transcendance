# ============================================
# ft_transcendence — .gitignore
# ============================================

# ── Dependencies ─────────────────────────────────────
node_modules/
.npm

# ── Build Outputs ────────────────────────────────────
dist/
build/
.next/
*.js.map

# ── Environment ──────────────────────────────────────
.env
.env.local
.env.development
.env.test
.env.production

# ── Prisma ───────────────────────────────────────────
apps/backend/generated/

# ── IDE ──────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Testing ──────────────────────────────────────────
coverage/
.nyc_output/
test-results*.json

# ── Docker ───────────────────────────────────────────
data/

# ── Temporary ────────────────────────────────────────
.temp
.tmp
tmp/
