# ================================================================
# CODEOWNERS — Prismatica
# ================================================================
# Defines who is automatically requested for review when a PR
# changes files in specific paths.
#
# Rules are evaluated top-to-bottom. The last matching rule wins.
# Owners are @github-username.
# ================================================================

# Default — every file requires review from the Tech Lead
*                               @LESdylan @serjimen

# Data API — Express + pg + mongodb
apps/data-api/                  @LESdylan @danielfdez17 @serjimen

# Frontend — React 19, Vite 6
apps/frontend/                  @vjan-nie @LESdylan

# Database schemas — SQL + NoSQL models (high-risk)
Model/                          @esettes @serjimen @LESdylan
Model/sql/                      @esettes @serjimen @LESdylan
Model/nosql/                    @esettes @serjimen @LESdylan

# Infrastructure — Docker, Compose, Makefile
apps/data-api/Dockerfile*       @esettes @serjimen
docker-compose*.yml             @esettes @serjimen
Makefile                        @esettes @serjimen

# CI/CD — any change here affects every developer
.github/                        @serjimen @LESdylan
.github/workflows/              @serjimen @LESdylan

# Documentation — Docusaurus, markdown, docs build output
*.md                            @danielfdez17
docs/                           @danielfdez17
static_docs/                    @danielfdez17 @LESdylan

# Scripts — utility and automation
scripts/                        @serjimen @LESdylan

# Environment config — sensitive, restricted
.env.example                    @serjimen @LESdylan
