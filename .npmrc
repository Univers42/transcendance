# ============================================
# ft_transcendence — pnpm / npm configuration
# ============================================
# Enforces strict dependency resolution:
#   • No phantom dependencies
#   • No peer dep mismatches silently ignored
#   • Clean, reproducible installs
# ============================================

# Strict peer dependency enforcement (the whole point of using pnpm)
strict-peer-dependencies=true

# Silence noise
fund=false
audit=false
update-notifier=false
loglevel=warn

# Prefer offline cache when available
prefer-offline=true

# Auto-install peers (pnpm 8+)
auto-install-peers=true
